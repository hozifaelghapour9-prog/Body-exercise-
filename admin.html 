<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b0e13">

  <title>BODY RESET | لوحة الإدارة</title>

  <link rel="stylesheet" href="style.css">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script defer src="app.js"></script>
</head>

<body data-page="admin">

  <main class="admin-shell">

    <!-- تسجيل الدخول -->

    <section id="loginScreen" class="login-screen">

      <div class="login-card">

        <a class="brand" href="index.html">
          <span class="brand-mark">B</span>
          <span>
            <strong>BODY RESET</strong>
            <small>ADMIN PANEL</small>
          </span>
        </a>

        <h1>تسجيل دخول المدير</h1>
        <p>سجّل الدخول للوصول إلى لوحة الإدارة.</p>

        <form id="loginForm">

          <label for="loginEmail">البريد الإلكتروني</label>
          <input
            id="loginEmail"
            class="field"
            type="email"
            autocomplete="username"
            required
            placeholder="name@example.com"
          >

          <label for="loginPassword">كلمة المرور</label>
          <input
            id="loginPassword"
            class="field"
            type="password"
            autocomplete="current-password"
            required
            placeholder="كلمة المرور"
          >

          <button class="btn btn-primary btn-full" type="submit">
            تسجيل الدخول
          </button>

          <p id="loginMessage" class="notice" role="status"></p>

        </form>

        <a class="back-link" href="index.html">
          العودة إلى الموقع
        </a>

      </div>

    </section>

    <!-- لوحة الإدارة -->

    <section id="adminApp" class="admin-app hidden">

      <header class="admin-header">

        <a class="brand" href="index.html">
          <span class="brand-mark">B</span>
          <span>
            <strong>BODY RESET</strong>
            <small>CONTROL PANEL</small>
          </span>
        </a>

        <div class="admin-header-actions">
          <span id="adminEmail" class="admin-email"></span>

          <button id="logoutBtn" class="btn btn-quiet" type="button">
            تسجيل الخروج
          </button>
        </div>

      </header>

      <div class="admin-layout">

        <aside class="admin-sidebar">

          <p class="sidebar-label">القائمة الرئيسية</p>

          <button class="admin-nav active" data-admin-tab="dashboard">
            الرئيسية
          </button>

          <button class="admin-nav" data-admin-tab="exercises">
            إدارة التمارين
          </button>

          <button class="admin-nav" data-admin-tab="programs">
            إدارة البرامج
          </button>

          <button class="admin-nav" data-admin-tab="clients">
            إدارة العملاء
          </button>

          <a class="admin-nav" href="index.html">
            عرض الموقع
          </a>

        </aside>

        <div class="admin-content">

          <!-- الرئيسية -->

          <section id="dashboard" class="admin-section">

            <div class="section-heading">
              <div>
                <p class="eyebrow">OVERVIEW</p>
                <h1>لوحة التحكم</h1>
                <p>ملخص محتوى BODY RESET.</p>
              </div>
            </div>

            <div class="stats-grid">

              <article class="stat-card">
                <span>إجمالي التمارين</span>
                <strong id="totalExercises">0</strong>
              </article>

              <article class="stat-card">
                <span>إجمالي البرامج</span>
                <strong id="totalPrograms">0</strong>
              </article>

              <article class="stat-card">
                <span>إجمالي العملاء</span>
                <strong id="totalClients">0</strong>
              </article>

            </div>

            <div class="content-card">
              <h2>أحدث التمارين</h2>
              <div id="recentExercises">
                لا توجد تمارين حتى الآن.
              </div>
            </div>

          </section>

          <!-- التمارين -->

          <section id="exercises" class="admin-section hidden">

            <div class="section-heading">
              <div>
                <p class="eyebrow">EXERCISES</p>
                <h1>إدارة التمارين</h1>
                <p>إضافة وتعديل ونشر التمارين.</p>
              </div>

              <button id="addExercise" class="btn btn-primary" type="button">
                + إضافة تمرين
              </button>
            </div>

            <div class="toolbar">
              <input
                id="exerciseSearch"
                class="field"
                type="search"
                placeholder="ابحث عن تمرين"
              >

              <select id="muscleFilter" class="field">
                <option value="">كل العضلات</option>
                <option>الصدر</option>
                <option>الظهر</option>
                <option>الأكتاف</option>
                <option>البايسبس</option>
                <option>الترايسبس</option>
                <option>الأرجل</option>
                <option>البطن</option>
                <option>الكارديو</option>
              </select>
            </div>

            <div id="exerciseGrid" class="exercise-grid"></div>

          </section>

          <!-- البرامج -->

          <section id="programs" class="admin-section hidden">

            <div class="section-heading">
              <div>
                <p class="eyebrow">PROGRAMS</p>
                <h1>إدارة البرامج</h1>
                <p>إنشاء البرامج التدريبية ونشرها.</p>
              </div>

              <button id="addProgram" class="btn btn-primary" type="button">
                + إضافة برنامج
              </button>
            </div>

            <div id="programList" class="program-grid"></div>

          </section>

          <!-- العملاء -->

          <section id="clients" class="admin-section hidden">

            <div class="section-heading">
              <div>
                <p class="eyebrow">CLIENTS</p>
                <h1>إدارة العملاء</h1>
                <p>إضافة بيانات العملاء ومتابعتهم.</p>
              </div>

              <button id="addClient" class="btn btn-primary" type="button">
                + إضافة عميل
              </button>
            </div>

            <div id="clientList" class="client-grid"></div>

          </section>

        </div>

      </div>

    </section>

  </main>

  <!-- نافذة الإضافة والتعديل -->

  <div id="modal" class="modal hidden" aria-hidden="true">

    <div class="modal-backdrop" data-close-modal></div>

    <div
      id="modalContent"
      class="modal-card"
      role="dialog"
      aria-modal="true"
    >

      <button
        class="modal-close"
        type="button"
        data-close-modal
        aria-label="إغلاق"
      >
        ×
      </button>

      <div id="modalBody"></div>

    </div>

  </div>

</body>
</html>